{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-iconv": "*",
        "ext-zip": "*",
        "symfony/cache": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/event-dispatcher": "7.4.*",
        "symfony/filesystem": "7.4.*",
        "symfony/string": "7.4.*",
        "symfony/yaml": "7.4.*",
        "twig/string-extra": "^3.3",
        "twig/twig": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "jms/serializer": "^3.32",
        "phpunit/phpunit": "^13.2"
    }
}
